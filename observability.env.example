# Secrets for the `observability` Compose profile only. api/api-dev/worker/
# worker-dev never read this file — they use docker.env. Copy to
# observability.env (gitignored) and fill in real values.

# Grafana admin account. Anonymous access and sign-up are disabled.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Label applied to every log line and used by Alloy's `env` label
# (dev/staging/production). Keep in sync with docker.env's DEPLOYMENT_ENV.
DEPLOYMENT_ENV=development

# Bearer token for Prometheus to scrape MinIO's /minio/v2/metrics/cluster.
# Generate against the running MinIO (find this Compose project's network
# with `docker network ls`, typically <project>_default) with:
#   docker run --rm --network <project>_default minio/mc \
#     alias set target http://minio:9000 <MINIO_ROOT_USER> <MINIO_ROOT_PASSWORD>
#   docker run --rm --network <project>_default minio/mc \
#     admin prometheus generate target
# and paste only the token value here (not the whole scrape-config snippet mc prints).
MINIO_PROMETHEUS_TOKEN=

# Discord webhook for Grafana alert notifications (wired up in issue 08).
DISCORD_WEBHOOK_URL=
