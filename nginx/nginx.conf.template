map_hash_bucket_size 128;

map $http_x_api_key $api_key_valid {
    default         0;
    "${NGINX_API_KEY}" 1;
}

server {
        listen 80;

        # Backend API
        location /twhp/api/ {
            if ($api_key_valid = 0) {
                return 401;
            }
            proxy_pass http://${NGINX_API_UPSTREAM}:3000;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # MinIO S3 API (for frontend to access static files)
        # Frontend accesses via /twhp/files/...
        # No API key check here — MinIO presigned URL signature handles auth
        location /twhp/files/ {
            rewrite ^/twhp/files/(.*)$ /twhp/$1 break;

            proxy_set_header Host minio:9000;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_connect_timeout 300;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            chunked_transfer_encoding off;

            # Ensure files open in the browser instead of downloading
            proxy_hide_header Content-Disposition;
            add_header Content-Disposition "inline";

            proxy_pass http://minio:9000;
        }

        # MinIO Console
        location ^~ /twhp/minio-console/ {
            if ($api_key_valid = 0) {
                return 401;
            }

            rewrite ^/twhp/minio-console/(.*) /$1 break;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-NginX-Proxy true;

            real_ip_header X-Real-IP;

            proxy_connect_timeout 300;

            # To support websockets
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            chunked_transfer_encoding off;

            proxy_pass http://minio:9001;
        }
    }
